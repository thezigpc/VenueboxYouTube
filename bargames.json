{
  "id": "youtube",
  "name": "YouTube",
  "kind": "app",
  "version": "0.3.3",
  "image": "ghcr.io/thezigpc/youtube:0.3.3",
  "port": 3006,
  "sdk": {
    "version": "0.10.4",
    "level": 3
  },
  "routes": {
    "player": "/",
    "host": "/admin",
    "admin": "/admin"
  },
  "routing": {
    "basePath": true
  },
  "health": "/health",
  "events": [],
  "commands": [
    "media_list",
    "media_play",
    "media_stop"
  ],
  "brandable": [
    "displayName",
    "accent"
  ],
  "resources": {
    "memory": "256m",
    "cpus": 1
  },
  "network": {
    "internet": true
  },
  "env": {
    "DATA_DIR": "/data"
  },
  "media": {
    "launch": [
      "youtube"
    ]
  }
}
